# Copy this file to "config.env" (same folder) and fill in your own values.
# config.env is git-ignored, so NEVER commit real passwords or API keys.

PORT=8000

# Frontend URL allowed by CORS (Vite dev server default)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (same "DB=" key as the Week 5 blog-with-mongodb example)
# Atlas -> your cluster -> Connect -> Drivers -> copy the string, put your password in,
# and put a database name after ".net/".
#   Local development: use YOUR OWN database name, e.g. carebridge_yuqi,
#                      so `pnpm seed` / E2E tests don't wipe teammates' data.
#   Deployed app:      carebridge
DB=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/carebridge_<yourname>?retryWrites=true&w=majority

# External LLM API used for AI handover summaries (owner: Yuqi)
# Free key: https://aistudio.google.com/apikey
# If left blank, the server falls back to a simple rule-based summary,
# so the app still works without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
